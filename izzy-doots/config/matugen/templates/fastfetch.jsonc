{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "~/.local/share/fastfetch/ascii/arch.txt",
    "padding": {
      "top": 1,
      "right": 3
    }
  },

  "display": {
    "separator": "  "
  },

  "modules": [
    {
      "type": "title",
      "format": "izzy@surfarch",
      "keyWidth": 8
    },

    {
      "type": "os",
      "key": "os",
      "keyColor": "{{colors.primary.default.hex}}"
    },

    {
      "type": "kernel",
      "key": "kernel",
      "format": "6.19.8 surface linux",
      "keyColor": "{{colors.primary.default.hex}}"
    },

    {
      "type": "host",
      "key": "host",
      "format": "Surface Pro 6",
      "keyColor": "{{colors.primary.default.hex}}"
    },

    {
      "type": "packages",
      "key": "pkgs",
      "format": "{} (pacman)",
      "keyColor": "{{colors.primary.default.hex}}"
    },

    {
      "type": "uptime",
      "key": "uptime",
      "keyColor": "{{colors.primary.default.hex}}"
    },

    {
      "type": "memory",
      "key": "memory",
      "keyColor": "{{colors.primary.default.hex}}"
    }
  ]
}
